{
  "id": "rust-workspace-two-roots",
  "title": "Workspace change to engine::compute — stay in-engine",
  "theme": "rust-workspace-two-roots",
  "language": "rust",
  "issue": "engine::compute must change its algorithm. Using the multi-root workspace index, find files that matter and avoid editing the web package unless it truly depends on compute.",
  "symbol": "compute",
  "workspace": {
    "manifest": "workspace.json",
    "roots": [
      {
        "id": "engine",
        "path": "packages/engine"
      },
      {
        "id": "web",
        "path": "packages/web"
      }
    ]
  },
  "expected": {
    "files_that_matter": [
      "packages/engine/src/lib.rs",
      "packages/engine/src/compute.rs"
    ],
    "noise_files": [
      "packages/web/src/lib.rs",
      "packages/web/src/pages.rs"
    ],
    "edges": [
      {
        "description": "engine entry calls compute",
        "site_file": "packages/engine/src/lib.rs",
        "site_contains": "compute"
      }
    ],
    "window": "any",
    "recommendation_present": true,
    "recommendation_contains_any": [],
    "who_calls": null,
    "scoped_guidance": {
      "expect_sound_candidates": false,
      "expect_window_not_sound": false,
      "companion_subset_sound_candidates": true,
      "recommendation_contains_any": []
    },
    "notes_extra": "Clean two-root workspace: union window may already be sound; sound_candidates on blast_radius are empty on sound window (honest). Subset companion still lists per-root scoped --sound candidates."
  },
  "recommended_tools": [
    "index",
    "blast-radius",
    "who-calls",
    "subset"
  ],
  "recommended_commands": [
    "agentgraph index --workspace workspace.json",
    "agentgraph blast-radius compute --workspace workspace.json",
    "agentgraph subset --workspace workspace.json"
  ],
  "notes": "Public synthetic two-root Rust workspace. Not a production monorepo."
}
